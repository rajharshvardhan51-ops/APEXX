// APEXX Cyberpunk RPG Life OS - Production PostgreSQL Schema
// Provider: PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum DomainCategory {
  DEV
  FITNESS
  MIND
  ACADEMICS
  HEALTH
  FINANCE
  SOCIAL
  ARTS
  CULTURE
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  fullName      String    @map("full_name")
  nickname      String    @map("nickname")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        Gender    @default(PREFER_NOT_TO_SAY)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profile       Profile?
  settings      UserSettings?
  migration     UserMigrationStatus?
  dailyQuests   DailyQuest[]
  habitRecords  HabitRecord[]
  dailyRecords  DailyRecord[]
  goals         Goal[]

  @@map("users")
}

model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  level           Int      @default(1)
  currentXp       Int      @default(0) @map("current_xp")
  xpToNextLevel   Int      @default(500) @map("xp_to_next_level")
  streak          Int      @default(0)
  currentTitle    String   @default("INITIATE") @map("current_title")
  honorific       String   @default("SIR")
  equippedFrame   String   @default("TITAN") @map("equipped_frame")
  avatarUrl       String?  @map("avatar_url")
  categoryXp      Json     @map("category_xp")
  completionIndex Float    @default(0.0) @map("completion_index")
  streakShields   Int      @default(0) @map("streak_shields")
  lastActiveDate  String   @map("last_active_date")
  dayCount        Int      @default(0) @map("day_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model DailyRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  date                 String   @db.VarChar(10) // YYYY-MM-DD
  completedQuestsCount Int      @default(0) @map("completed_quests_count")
  totalQuestsCount     Int      @default(0) @map("total_quests_count")
  consistencyScore     Float    @default(0.0) @map("consistency_score")
  statusCode           String   @default("UNLOGGED") @map("status_code")
  xpEarned             Int      @default(0) @map("xp_earned")
  createdAt            DateTime @default(now()) @map("created_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_records")
}

model DailyQuest {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  questId            String         @map("quest_id")
  title              String
  domain             DomainCategory
  targetDurationMins Int            @map("target_duration_mins")
  xpReward           Int            @map("xp_reward")
  priority           String         @default("CRITICAL")
  tip                String?
  completed          Boolean        @default(false)
  scheduledDate      String         @map("scheduled_date")
  createdAt          DateTime       @default(now()) @map("created_at")

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_quests")
}

model HabitRecord {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String
  metricPayload Json     @map("metric_payload")
  xpEarned      Int      @map("xp_earned")
  timestamp     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("habit_records")
}

model Goal {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  milestoneId String    @map("milestone_id")
  title       String
  category    String    @default("GRADUATION")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model UserSettings {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  soundEnabled Boolean  @default(true) @map("sound_enabled")
  masterVolume Float    @default(0.5) @map("master_volume")
  theme        String   @default("dark")
  geminiApiKey String?  @map("gemini_api_key")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserMigrationStatus {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  migratedAt      DateTime? @map("migrated_at")
  importedData    Boolean   @default(false) @map("imported_data")
  recordsImported Int       @default(0) @map("records_imported")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_migration_status")
}
